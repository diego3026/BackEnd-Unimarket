# Copia este archivo como .env para desarrollo local. En Railway se configuran como Variables.

ENVIRONMENT=development          # development | production
# Railway: usa la referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://unimarket:unimarket@localhost:5432/unimarket

# Genera valores propios:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta-de-64-caracteres
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_MINUTES=30
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
REFRESH_TOKEN_DAYS=30

# Dominios web que pueden llamar la API (la app móvil no lo necesita). Separados por coma.
CORS_ORIGINS=
# En producción: tu-servicio.up.railway.app
ALLOWED_HOSTS=*
ENABLE_DOCS=true

AUTO_APPROVE_STORES=false
ENABLE_RESEARCH_API=true

# Correo por API HTTPS (Railway Hobby bloquea SMTP). Ver docs/SERVICIOS.md
# console (solo log) | gmail (sin dominio, recomendado) | brevo | resend (requiere dominio)
EMAIL_PROVIDER=console
EMAIL_FROM=UniMarket <tu-cuenta@gmail.com>
EMAIL_REPLY_TO=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=          # python -m scripts.gmail_token --client-id ... --client-secret ...
BREVO_API_KEY=
RESEND_API_KEY=

# Imágenes y documentos (Cloudinary, plan gratis). Ver docs/SERVICIOS.md
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Tarjetas: vacío = desactivado (por ahora se paga en efectivo, Nequi o Bre-B)
CARD_PAYMENT_PROVIDER=

# Rendimiento
WEB_CONCURRENCY=2              # procesos de la API (≈ núcleos de CPU)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=10000
PUBLIC_CACHE_SECONDS=30

# Primer administrador (python -m scripts.seed)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Límite de intentos. Con varias réplicas en Railway agrega Redis y usa su URL.
RATE_LIMIT_STORAGE_URI=memory://
